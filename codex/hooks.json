{
  "hooks": {
    "PermissionRequest": [
      {
        "hooks": [
          {
            "command": "/home/cpf/.codex/hooks/win-ntf-notify.sh approve",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "/home/cpf/.codex/hooks/win-ntf-notify.sh error",
            "timeout": 10,
            "type": "command"
          }
        ]
      },
      {
        "hooks": [],
        "matcher": ""
      }
    ],
    "PreCompact": [
      {
        "hooks": [],
        "matcher": ""
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "/home/cpf/.codex/hooks/win-ntf-notify.sh question",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "AskUserQuestion|question|ask_user_question"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "bash '/home/cpf/.codex/herdr-agent-state.sh' session",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "/home/cpf/.local/bin/plannotator",
            "timeout": 345600,
            "type": "command"
          }
        ]
      },
      {
        "hooks": [
          {
            "command": "/home/cpf/.codex/hooks/win-ntf-notify.sh idle",
            "timeout": 10,
            "type": "command"
          }
        ]
      }
    ]
  }
}
