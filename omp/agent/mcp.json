{
  "$schema": "https://raw.githubusercontent.com/can1357/oh-my-pi/main/packages/coding-agent/src/config/mcp-schema.json",
  "mcpServers": {
    "context7": {
      "type": "stdio",
      "command": "context7-mcp",
      "args": [
        "--api-key",
        "<REDACTED>"
      ]
    },
    "deep-wiki": {
      "type": "http",
      "url": "https://mcp.deepwiki.com/mcp"
    },
    "search-exa": {
      "type": "http",
      "url": "https://mcp.exa.ai/mcp?exaApiKey=<REDACTED>"
    },
    "search-tavily": {
      "type": "http",
      "url": "https://mcp.tavily.com/mcp/?tavilyApiKey=<REDACTED>"
    },
    "chrome-devtools": {
      "type": "stdio",
      "command": "/home/cpf/.bun/bin/chrome-devtools-mcp",
      "args": [
        "--browserUrl",
        "http://127.0.0.1:9333",
        "--no-usage-statistics",
        "--no-performance-crux"
      ]
    },
    "codegraph": {
      "type": "stdio",
      "command": "codegraph",
      "args": [
        "serve",
        "--mcp"
      ]
    },
    "ddgs": {
      "type": "stdio",
      "command": "/home/cpf/.local/bin/ddgs",
      "args": [
        "mcp"
      ]
    },
    "headroom": {
      "type": "http",
      "url": "http://127.0.0.1:8788/mcp"
    },
    "context-mode": {
      "type": "stdio",
      "command": "context-mode"
    },
    "mintlify-index": {
      "type": "http",
      "url": "https://index.mintlify.com"
    },
    "grep-app-github": {
      "type": "http",
      "url": "https://mcp.grep.app"
    },
    "excalidraw": {
      "type": "stdio",
      "command": "/home/cpf/.bun/bin/mcp-excalidraw-server",
      "args": []
    }
  }
}