{
  "defaultProvider": "kimi-coding",
  "defaultModel": "k3",
  "telemetry": {
    "noticeShown": true,
    "enabled": false
  },
  "defaultThinkingLevel": "max",
  "hideThinkingBlock": false,
  "thinkingBudgets": {
    "minimal": 1024,
    "low": 2048,
    "medium": 8192,
    "high": 16384
  },
  "theme": "dark",
  "quietStartup": false,
  "treeFilterMode": "user-only",
  "autocompleteMaxVisible": 5,
  "showHardwareCursor": true,
  "compaction": {
    "enabled": true,
    "reserveTokens": 16384,
    "keepRecentTokens": 20000
  },
  "branchSummary": {
    "reserveTokens": 16384,
    "skipPrompt": false
  },
  "retry": {
    "enabled": true,
    "maxRetries": 3,
    "baseDelayMs": 500,
    "provider": {
      "maxRetryDelayMs": 60000
    }
  },
  "steeringMode": "all",
  "followUpMode": "all",
  "transport": "auto",
  "terminal": {
    "showImages": true,
    "showTerminalProgress": true,
    "fullscreen": true
  },
  "images": {
    "autoResize": true,
    "blockImages": false
  },
  "enableSkillCommands": false,
  "npmCommand": [
    "bun"
  ],
  "mcpServers": {
    "graphiti-memory": {
      "type": "http",
      "url": "http://127.0.0.1:8000/mcp/"
    },
    "context7": {
      "type": "stdio",
      "command": "context7-mcp",
      "env": {
        "CONTEXT7_API_KEY": {
          "env": "CONTEXT7_API_KEY"
        }
      }
    },
    "mintlify-index": {
      "type": "http",
      "url": "https://index.mintlify.com"
    },
    "deep-wiki": {
      "type": "http",
      "url": "https://mcp.deepwiki.com/mcp"
    },
    "search-exa": {
      "type": "http",
      "url": "https://mcp.exa.ai/mcp",
      "headers": {
        "x-api-key": "<REDACTED>"
      }
    },
    "grep-app": {
      "type": "http",
      "url": "https://mcp.grep.app"
    },
    "search-tavily": {
      "type": "http",
      "url": "https://mcp.tavily.com/mcp/",
      "headers": {
        "x-api-key": "<REDACTED>"
      }
    },
    "firecrawl": {
      "type": "http",
      "url": "https://mcp.firecrawl.dev/<REDACTED>/v2/mcp"
    },
    "chrome-devtools": {
      "type": "stdio",
      "command": "/home/cpf/.bun/bin/chrome-devtools-mcp",
      "args": [
        "--browserUrl",
        "http://127.0.0.1:9333",
        "--no-usage-statistics",
        "--no-performance-crux"
      ]
    },
    "jina": {
      "type": "http",
      "url": "https://mcp.jina.ai/v1",
      "headers": {
        "Authorization": "Bearer <REDACTED>"
      }
    },
    "codegraph": {
      "type": "stdio",
      "command": "codegraph",
      "args": [
        "serve",
        "--mcp"
      ]
    },
    "ddgs": {
      "type": "stdio",
      "command": "/home/cpf/.local/bin/ddgs",
      "args": [
        "mcp"
      ]
    },
    "headroom": {
      "type": "http",
      "url": "http://127.0.0.1:8788/mcp"
    },
    "context-mode": {
      "type": "stdio",
      "command": "context-mode"
    }
  },
  "recentModels": [
    "kimi-coding/k3",
    "c8787/gpt-5.6-luna"
  ],
  "editorPaddingX": 1
}