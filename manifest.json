      "source": "~/.config/opencode/cli.json",
      "repo": "opencode/cli.json",
      "protected": true
    },
    {
      "name": "opencode-dcp",
      "source": "~/.config/opencode/dcp.jsonc",
      "repo": "opencode/dcp.jsonc",
      "protected": true
