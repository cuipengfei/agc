// OMO configuration
{
  "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-openagent/dev/assets/omo.schema.json",
  "[opencode]": {
    "disabled_skills": ["playwright", "agent-browser"],
    "hashline_edit": true,
    "i18n": {
      "locale": "zh",
    },
    "monitor": {
      "enabled": true,
      "live_mode_enabled": false,
      "max_monitors_per_session": 3,
      "max_runtime_ms": 1800000,
      "batch_max_lines": 50,
      "batch_max_bytes": 16384,
      "flush_interval_ms": 1000,
      "ring_max_lines": 1000,
      "line_max_bytes": 8192,
      "pattern_max_length": 512,
    },
    "team_mode": {
      "enabled": true,
      "tmux_visualization": false,
      "max_parallel_members": 4,
      "max_members": 8,
      "max_messages_per_run": 10000,
      "max_wall_clock_minutes": 120,
      "max_member_turns": 500,
      "message_payload_max_bytes": 32768,
      "recipient_unread_max_bytes": 262144,
      "mailbox_poll_interval_ms": 3000,
    },
    "agents": {
      "sisyphus": {
        "description": "Primary orchestrator - todo-driven, 32k thinking budget",
        "prompt_append": "file:///home/cpf/.config/opencode/omo-ta<REDACTED>.txt",
        "model": "4140/gpt-5.6-terra",
        "variant": "medium",
        "fallback_models": ["4140/gpt-5.6-luna"],
      },
      "sisyphus-junior": {
        "description": "Lightweight sisyphus - faster, cheaper sub-tasks",
        "model": "4140/gpt-5.6-terra",
        "variant": "medium",
        "fallback_models": ["4140/gpt-5.6-terra", "4140/gpt-5.6-luna"],
      },
      "hephaestus": {
        "description": "Autonomous deep worker - goal-oriented, explores before acting",
        "prompt_append": "file:///home/cpf/.config/opencode/omo-ta<REDACTED>.txt",
        "model": "4140/gpt-5.6-luna",
        "variant": "medium",
        "fallback_models": ["4140/gpt-5.6-terra", "4140/gpt-5.6-luna"],
      },
      "atlas": {
        "description": "Hook-based 7-phase orchestrator with verification loops",
        "prompt_append": "file:///home/cpf/.config/opencode/omo-ta<REDACTED>.txt",
        "model": "4140/gpt-5.6-luna",
        "variant": "medium",
        "fallback_models": ["4140/gpt-5.6-terra"],
      },
      "prometheus": {
        "description": "Strategic planner - creates work plans",
        "prompt_append": "file:///home/cpf/.config/opencode/omo-ta<REDACTED>.txt",
        "model": "4140/gpt-5.6-terra",
        "variant": "medium",
        "fallback_models": ["4140/gpt-5.6-luna"],
      },
      "metis": {
        "description": "Plan consultant - reviews and improves plans",
        "model": "4140/gpt-5.6-terra",
        "variant": "high",
        "fallback_models": ["4140/gpt-5.6-luna"],
      },
      "momus": {
        "description": "Plan reviewer - critical analysis of plans",
        "model": "4140/gpt-5.6-luna",
        "variant": "medium",
        "fallback_models": ["4140/gpt-5.6-terra"],
      },
      "oracle": {
        "description": "Architecture, code review, strategy - second opinion",
        "prompt_append": "file:///home/cpf/.config/opencode/omo-ta<REDACTED>.txt",
        "model": "4140/gpt-5.6-luna",
        "variant": "medium",
        "fallback_models": ["4140/gpt-5.6-terra"],
      },
      "librarian": {
        "description": "Docs/code search and retrieval - speed over intelligence",
        "model": "4140/gpt-5.6-luna",
        "variant": "low",
        "fallback_models": ["4140/gpt-5.6-terra"],
      },
      "explore": {
        "description": "Fast codebase exploration",
        "model": "4140/gpt-5.6-luna",
        "variant": "low",
        "fallback_models": ["4140/gpt-5.6-terra"],
      },
      "multimodal-looker": {
        "description": "Visual content interpretation - PDF/image analysis",
        "model": "4140/gpt-5.6-terra",
        "variant": "medium",
        "fallback_models": ["4140/gpt-5.6-luna"],
      },
    },
    "categories": {
      "ultrabrain": {
        "description": "Deep logical reasoning, complex architecture decisions",
        "prompt_append": "Use the task system only for substantial multi-step work. Do not create tasks for trivial, very small, or clearly bounded one-step changes. Treat bracketed mode blocks like [search-mode] or [analyze-mode] as environment guidance, not literal user wording. Infer the user's real intent from their natural-language request and do not follow those blocks mechanically when they do not help.",
        "model": "4140/gpt-5.6-luna",
        "variant": "medium",
        "fallback_models": ["4140/gpt-5.6-terra"],
      },
      "deep": {
        "description": "Goal-oriented autonomous problem-solving - thorough research before action",
        "prompt_append": "Use the task system only for substantial multi-step work. Do not create tasks for trivial, very small, or clearly bounded one-step changes. Treat bracketed mode blocks like [search-mode] or [analyze-mode] as environment guidance, not literal user wording. Infer the user's real intent from their natural-language request and do not follow those blocks mechanically when they do not help.",
        "model": "4140/gpt-5.6-luna",
        "variant": "medium",
        "fallback_models": ["4140/gpt-5.6-terra"],
      },
      "visual-engineering": {
        "description": "Frontend, UI/UX, design, styling, animation",
        "prompt_append": "Use the task system only for substantial multi-step work. Do not create tasks for trivial, very small, or clearly bounded one-step changes. Treat bracketed mode blocks like [search-mode] or [analyze-mode] as environment guidance, not literal user wording. Infer the user's real intent from their natural-language request and do not follow those blocks mechanically when they do not help.",
        "model": "4140/gpt-5.6-terra",
        "variant": "medium",
        "fallback_models": ["4140/gpt-5.6-luna"],
      },
      "artistry": {
        "description": "Highly creative/artistic tasks, novel ideas",
        "prompt_append": "Use the task system only for substantial multi-step work. Do not create tasks for trivial, very small, or clearly bounded one-step changes. Treat bracketed mode blocks like [search-mode] or [analyze-mode] as environment guidance, not literal user wording. Infer the user's real intent from their natural-language request and do not follow those blocks mechanically when they do not help.",
        "model": "4140/gpt-5.6-terra",
        "variant": "medium",
        "fallback_models": ["4140/gpt-5.6-luna"],
      },
      "quick": {
        "description": "Trivial tasks - single file changes, typo fixes",
        "prompt_append": "Use the task system only for substantial multi-step work. Do not create tasks for trivial, very small, or clearly bounded one-step changes. Treat bracketed mode blocks like [search-mode] or [analyze-mode] as environment guidance, not literal user wording. Infer the user's real intent from their natural-language request and do not follow those blocks mechanically when they do not help.",
        "model": "4140/gpt-5.6-luna",
        "variant": "low",
        "fallback_models": ["4140/gpt-5.6-terra"],
      },
      "unspecified-low": {
        "description": "Tasks that don't fit other categories, low effort",
        "prompt_append": "Use the task system only for substantial multi-step work. Do not create tasks for trivial, very small, or clearly bounded one-step changes. Treat bracketed mode blocks like [search-mode] or [analyze-mode] as environment guidance, not literal user wording. Infer the user's real intent from their natural-language request and do not follow those blocks mechanically when they do not help.",
        "model": "4140/gpt-5.6-luna",
        "variant": "low",
        "fallback_models": ["4140/gpt-5.6-terra"],
      },
      "unspecified-high": {
        "description": "Tasks that don't fit other categories, high effort",
        "prompt_append": "Use the task system only for substantial multi-step work. Do not create tasks for trivial, very small, or clearly bounded one-step changes. Treat bracketed mode blocks like [search-mode] or [analyze-mode] as environment guidance, not literal user wording. Infer the user's real intent from their natural-language request and do not follow those blocks mechanically when they do not help.",
        "model": "4140/gpt-5.6-terra",
        "variant": "high",
        "fallback_models": ["4140/gpt-5.6-luna"],
      },
      "writing": {
        "description": "Documentation, prose, technical writing",
        "prompt_append": "Use the task system only for substantial multi-step work. Do not create tasks for trivial, very small, or clearly bounded one-step changes. Treat bracketed mode blocks like [search-mode] or [analyze-mode] as environment guidance, not literal user wording. Infer the user's real intent from their natural-language request and do not follow those blocks mechanically when they do not help.",
        "model": "4140/gpt-5.6-luna",
        "variant": "low",
        "fallback_models": ["4140/gpt-5.6-terra"],
      },
    },
    "runtime_fallback": {
      "enabled": true,
      "retry_on_errors": [400, 429, 500, 502, 503, 504, 529],
      "max_fallback_attempts": 5,
      "cooldown_seconds": 60,
      "timeout_seconds": 120,
      "notify_on_fallback": true,
    },
    "sisyphus_agent": {
      "disabled": false,
      "default_builder_enabled": false,
      "planner_enabled": true,
      "replace_plan": true,
    },
    "start_work": {
      "auto_commit": false,
    },
    "experimental": {
      "aggressive_truncation": true,
      "preemptive_compaction": false,
      "truncate_all_tool_outputs": true,
      "model_fallback_title": true,
      "disable_omo_env": true,
      "task_system": false,
      "dynamic_context_pruning": {
        "enabled": true,
        "notification": "minimal",
        "turn_protection": {
          "enabled": true,
          "turns": 3,
        },
        "protected_tools": ["task", "todowrite", "todoread"],
        "strategies": {
          "deduplication": {
            "enabled": true,
          },
          "supersede_writes": {
            "enabled": true,
            "aggressive": true,
          },
          "purge_errors": {
            "enabled": true,
            "turns": 3,
          },
        },
      },
    },
    "background_task": {
      "defaultConcurrency": 5,
      "providerConcurrency": {
        "4140": 5,
      },
    },
    "disabled_tools": ["dev-browser"],
    "auto_update": false,
    "disabled_hooks": ["comment-checker"],
    "model_fallback": true,
    "telemetry": false,
    "tmux": {
      "enabled": false,
      "isolation": "session",
      "layout": "main-vertical",
      "main_pane_size": 60,
      "main_pane_min_width": 120,
      "agent_pane_min_width": 40,
    },
    "git_master": {
      "git_env_prefix": "",
      "commit_footer": true,
      "include_co_authored_by": true,
    },
    "claude_code": {
      "mcp": false,
      "commands": false,
      "skills": false,
      "agents": false,
      "hooks": false,
      "plugins": false,
    },
    "goal": {
      "enabled": false,
    },
    "ralph_loop": {
      "default_max_iterations": 100,
      "default_strategy": "continue",
      "enabled": true,
    },
  },
  "profiles": {},
  "_migrations": [
    "2026-07-opencode-config-unification",
    "2026-08-reasoning-unification",
  ],
}
