{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["schemaVersion", "inputSha256", "memorySha256", "fonts", "clocks", "panicFunctions", "manualEdits", "decision"],
  "properties": {
    "schemaVersion": {"const": 1},
    "inputSha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "memorySha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "decision": {"const": "manual_review_required"},
    "fonts": {
      "type": "array",
      "items": {
        "type": "object", "required": ["family", "pointer", "length", "slot"],
        "properties": {
          "family": {"type": "string", "minLength": 1},
          "pointer": {"type": "integer", "minimum": 1, "maximum": 4294967295},
          "length": {"type": "integer", "minimum": 1, "maximum": 4294967295},
          "slot": {"type": "integer", "minimum": 1, "maximum": 4294967287}
        }
      }
    },
    "clocks": {"type": "array"},
    "panicFunctions": {"type": "array"},
    "manualEdits": {
      "type": "array", "items": {
        "type": "object", "required": ["callerIndex", "original", "following", "timestampBufferCandidates", "decision"],
        "properties": {
          "callerIndex": {"type": "integer", "minimum": 0},
          "original": {"type": "string", "minLength": 1},
          "following": {"type": "array", "items": {"type": "string"}},
          "timestampBufferCandidates": {"type": "array"},
          "decision": {"const": "manual_review_required"}
        }
      }
    }
  }
}
