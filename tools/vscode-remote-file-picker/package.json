{
  "name": "remote-file-picker",
  "displayName": "Remote File Picker",
  "description": "Select server files with Yazi in a VS Code editor terminal.",
  "publisher": "cpf-local",
  "version": "0.3.0",
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "https://github.com/cuipengfei/agc.git",
    "directory": "tools/vscode-remote-file-picker"
  },
  "engines": { "vscode": "^1.90.0" },
  "categories": ["Other"],
  "main": "./extension.js",
  "extensionKind": ["workspace"],
  "capabilities": { "untrustedWorkspaces": { "supported": true } },
  "contributes": {
    "commands": [{
      "command": "remoteFilePicker.open",
      "title": "Remote File Picker: Open File",
      "enablement": "isWeb"
    }],
    "keybindings": [{
      "command": "remoteFilePicker.open",
      "key": "ctrl+o",
      "when": "isWeb && !terminalFocus"
    }],
    "menus": {
      "commandPalette": [{ "command": "remoteFilePicker.open", "when": "isWeb" }]
    }
  },
  "devDependencies": {
    "puppeteer-core": "25.18.1"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "smoke": "node test/smoke.js",
    "package": "bunx @vscode/vsce@4.1.1 package --no-dependencies"
  }
}
